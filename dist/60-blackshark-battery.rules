# UPower derives a HID battery's kind from its sibling input node. Mark the input node
# of the virtual device created by blackshark-battery as a headset sound device.
SUBSYSTEM=="input", KERNEL=="input*", ATTR{uniq}=="blackshark-v2-hyperspeed", ENV{SOUND_INITIALIZED}="1", ENV{SOUND_FORM_FACTOR}="headset"
